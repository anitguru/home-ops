    {
      "id": "validate_request",
      "name": "Validate Authoring Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r=$input.first().json;\nif(r.runMode!=='shadow') throw new Error('authoring accepts shadow mode only');\nif(!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(r.date||''))) throw new Error('invalid date');\nif(!Number.isInteger(r.episode)||r.episode<1) throw new Error('invalid episode');\nif(!Array.isArray(r.selectedStories)||r.selectedStories.length!==4) throw new Error('authoring requires four selected stories');\nreturn [{json:r}];"
      },
      "notes": ""
    },
    {
      "id": "episode_words",
      "name": "Format Spoken Episode Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r=$input.first().json;const ones=['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen'];const tens=['','','twenty','thirty','forty','fifty','sixty','seventy','eighty','ninety'];\nconst under=n=>{const p=[];if(n>=100){p.push(ones[Math.floor(n/100)],'hundred');n%=100;}if(n>=20){p.push(tens[Math.floor(n/10)]);if(n%10)p.push(ones[n%10]);}else if(n)p.push(ones[n]);return p.join(' ');};\nconst n=r.episode;if(n>999999) throw new Error('episode number exceeds spoken formatter');\nconst episodeSpoken=n<1000?under(n):`${under(Math.floor(n/1000))} thousand${n%1000?' '+under(n%1000):''}`;\nconst dayName=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'long'}).format(new Date(`${r.date}T12:00:00-04:00`));\nreturn [{json:{...r,episodeSpoken,dayName}}];"
      },
      "notes": ""
    },
    {
      "id": "prompt",
      "name": "Build Six-Paragraph Author Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r=$input.first().json;\nconst rules=`Write a 60-90 second spoken script. Hard acceptance range: 330-400 words; target 365-390. Use a rambling, self-interrupting blue-collar everyman voice enthusiastic about AI, with at most one exact chuckle: Heh. Hhh, okay, that's something. No stage directions.\\n\\nExactly 6 paragraphs separated by blank lines:\\n1. Good morning, it's ${r.dayName}. This is Guru's Tech Bytes, episode ${r.episodeSpoken}. Never put digits in the greeting.\\n2. Lead with First up...\\n3. Lead with Second...\\n4. Lead with Third...\\n5. Lead with And finally...\\n6. Exactly: That's your daily byte. Have a great day. Until next time.\\n\\nOutput only script text.`;\nconst stories=r.selectedStories.map((s,i)=>`${i+1}. ${s.title} (${Number(s.score||0)} upvotes)`).join('\\n');\nreturn [{json:{...r,authorPrompt:`${rules}\\n\\nThe four stories, in order:\\n${stories}`,authoringAttempt:1}}];"
      },
      "notes": ""
    },
