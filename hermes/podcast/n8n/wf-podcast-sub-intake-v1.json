            "selected_stories_json": "={{ JSON.stringify($json.selectedStories) }}",
            "script_sha256": "",
            "audio_sha256": "",
            "srt_sha256": "",
            "qa_json": "={{ JSON.stringify($json.rankingProof) }}",
            "artifact_urls_json": "",
