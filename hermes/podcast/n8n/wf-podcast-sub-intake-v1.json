    },
    {
      "id": "merge_episode",
      "name": "Merge Supabase Episode Lookups",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "id": "choose_episode",
      "name": "Choose Idempotent Episode Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const request = $('Validate Intake Request').first().json;\nconst sameDate = $('Supabase - Find Episode for Date').first().json;\nconst latest = $('Supabase - Get Latest Episode').first().json;\nconst episode = Number(sameDate.episode || 0) || (Number(latest.episode || 0) + 1);\nif (!Number.isInteger(episode) || episode < 1) throw new Error('Supabase returned no valid episode number');\nreturn [{json:{...request,episode,episodeSource:sameDate.episode?'existing-date':'latest-plus-one'}}];"
      },
      "notes": ""
    },
    {
      "id": "hacker_news",
      "name": "Hacker News - Get Front Page",
      "type": "n8n-nodes-base.hackerNews",
      "typeVersion": 1,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "resource": "all",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "additionalFields": {
          "tags": [
            "front_page"
          ]
        }
      },
      "notes": "Native Hacker News node; this maps to the same Algolia front_page feed previously called through HTTP."
    },
    {
      "id": "normalize",
      "name": "Normalize Hacker News Stories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context = $('Choose Idempotent Episode Number').first().json;\nconst stories = $input.all().map(({json:s}) => ({\n  id:String(s.objectID || s.id || ''),\n  title:String(s.title || s.story_title || '').replace(/\\s+/g,' ').trim(),\n  url:String(s.url || s.story_url || '').trim(),\n  hnUrl:`https://news.ycombinator.com/item?id=${s.objectID || s.id}`,\n  score:Number(s.points || s.score || 0),\n  createdAt:s.created_at || null,\n})).filter(s => /^https?:\\/\\//.test(s.url) && s.id && s.title);\nif (stories.length < 4) throw new Error(`only ${stories.length} usable Hacker News stories`);\nreturn [{json:{...context,stories}}];"
      },
      "notes": ""
    },
    {
      "id": "domain",
      "name": "Deduplicate Story Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context = $input.first().json;\nconst seen = new Set();\nconst stories = context.stories.filter(story => {\n  const domain = story.url.replace(/^https?:\\/\\//i,'').split('/')[0].split(':')[0].toLowerCase().replace(/^www\\./,'');\n  if (!domain || !domain.includes('.')) return false;\n  if (seen.has(domain)) return false;\n  seen.add(domain); story.domain = domain; return true;\n});\nif (stories.length < 4) throw new Error(`only ${stories.length} domain-diverse stories`);\nreturn [{json:{...context,stories}}];"
      },
      "notes": ""
    },
    {
      "id": "select",
      "name": "Select Four Stories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context=$input.first().json;\nif(context.rankingProof?.rankingMode!=='topic-index'||context.rankingProof?.usedTopicIndex!==true) throw new Error('CocoIndex topic proof missing');\nconst nonDuplicates=context.stories.filter(s=>!s.isRecentDuplicate);\nconst pool=nonDuplicates.length>=4?nonDuplicates:context.stories;\nconst selectedStories=pool.slice(0,4).map((story,index)=>({\n  id:story.id,title:story.title,url:story.url,hnUrl:story.hnUrl,score:story.score,createdAt:story.createdAt,domain:story.domain,\n  rank:index+1,rankScore:story.combinedScore,matchedTopics:story.matchedTopics||[],isRecentDuplicate:Boolean(story.isRecentDuplicate),\n  cocoindexReason:[`matched trending topics: ${(story.matchedTopics||[]).join(', ')||'none'}`,`HN score: ${story.score}`,story.isRecentDuplicate?'recently covered duplicate':'not recently covered']\n}));\nif(selectedStories.length!==4||new Set(selectedStories.map(s=>s.domain)).size!==4) throw new Error('four-story selection proof failed');\nif(nonDuplicates.length>=4&&selectedStories.some(s=>s.isRecentDuplicate)) throw new Error('recent duplicate selected despite sufficient alternatives');\nreturn [{json:{runMode:context.runMode,date:context.date,runId:context.runId,attempt:context.attempt,episode:context.episode,episodeSource:context.episodeSource,selectedStories,candidateCount:context.stories.length,rankingProof:{...context.rankingProof,domainDiverse:true,selectedCount:4,nonDuplicateCandidateCount:nonDuplicates.length}}}];"
      },
      "notes": ""
    },
    {
      "id": "ledger",
      "name": "Ledger - Intake Selected",
      "type": "n8n-nodes-base.dataTable",
