      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "podcast_episodes",
        "returnAll": false,
        "limit": 1,
        "orderBy": "episode.desc",
        "filterType": "none"
      },
      "credentials": {
        "supabaseApi": {
