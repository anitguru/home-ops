{
	admin off
	auto_https disable_redirects
	email me@anit.guru
}

https://ollama-lan.anit.guru:11435 {
	# Bind only to this Mac's LAN address. The existing Ollama HTTP listener on
	# port 11434 remains unchanged.
	bind 10.0.10.210

	tls {
		dns bunny {env.BUNNY_API_KEY}
		resolvers 1.1.1.1 8.8.8.8
	}

	# Require an OpenAI-compatible API key on the HTTPS endpoint. The direct
	# Ollama listener on port 11434 remains unchanged.
	@unauthorized not header Authorization "Bearer {$M5_TLS_API_KEY}"
	respond @unauthorized "Unauthorized" 401

	reverse_proxy 127.0.0.1:11434 {
		# Authenticate at Caddy and do not forward the credential to Ollama.
		header_up -Authorization
		# Ollama is strict about unexpected vanity Host headers in some paths.
		header_up Host 127.0.0.1:11434
	}
}
